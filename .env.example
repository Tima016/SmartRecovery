# ════════════════════════════════════════════════════
# IDFR Platform — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════

# ── Frontend ──────────────────────────────────────
# Port nginx listens on (default: 80)
FRONTEND_PORT=80

# Backend API URL (used by Vite at build time)
VITE_API_URL=http://backend:7000

# ── Database ──────────────────────────────────────
POSTGRES_DB=idfr
POSTGRES_USER=idfr
# !! CHANGE THIS !!
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────
# !! CHANGE THIS !!
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Backend / Auth ────────────────────────────────
# Must be a long random string — e.g. openssl rand -hex 64
JWT_SECRET=CHANGE_ME_REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=7d

# ── Node ──────────────────────────────────────────
NODE_ENV=production
PORT=5000
